# ch6-multimodal-perception Configuration Environment Variables

# Concurrency & Directories
PIPELINE_CONCURRENCY=5
SAMPLE_DATA_DIR=data/samples
REGISTRY_DB_PATH=data/registry.db

# Perception confidence routing
HIGH_CONFIDENCE_THRESHOLD=0.85
LOW_CONFIDENCE_THRESHOLD=0.50
VLM_CROP_STRATEGY=zone_crop

# Embeddings config
ENABLE_SPARSE_EMBEDDINGS=True
DENSE_EMBEDDING_MODEL=clip-ViT-B-32

# Cloud VLM config (Google Gemini)
# Obtain from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Local VLM config (Ollama)
USE_LOCAL_VLM=False
LOCAL_VLM_MODEL=llava
OLLAMA_HOST=http://localhost:11434

# Whisper Audio Extraction Config
WHISPER_MODEL_SIZE=base

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here_if_using_cloud
QDRANT_COLLECTION=multimodal_perception

# Hugging Face Configuration (Optional)
HF_TOKEN=your_hugging_face_token_here_if_needed
