# ============================================================
# Chapter 6: Multimodal Perception - Environment Configuration
# Copy to .env and fill in real values (never commit .env)
# ============================================================

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=./data
SAMPLE_DATA_DIR=./data/samples

# --- NeonDB (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ch6_perception
NEON_DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/ch6_perception?sslmode=require

# --- Qdrant Vector Store ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PDF=ch6_pdf_chunks
QDRANT_COLLECTION_IMAGE=ch6_image_chunks
QDRANT_COLLECTION_TABLE=ch6_table_chunks
QDRANT_COLLECTION_AUDIO=ch6_audio_chunks

# --- Embedding Models ---
DENSE_EMBED_MODEL=jinaai/jina-embeddings-v3
DENSE_EMBED_DIM=1024
SPARSE_EMBED_MODEL=naver/splade-cocondenser-ensemble-distil

# --- VLM (Vision Language Model) ---
VLM_MODEL=HuggingFaceTB/SmolVLM-Instruct
VLM_MAX_NEW_TOKENS=512

# --- NER Model ---
GLINER_MODEL=urchade/gliner_medium-v2.1

# --- Whisper (Audio) ---
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# --- OpenAI (optional fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Pipeline Tuning ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
HYBRID_ALPHA=0.7
MAX_CONCURRENT_TASKS=4
BATCH_SIZE=16
